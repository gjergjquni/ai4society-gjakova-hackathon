# No secrets required for local municipal routing.
APP_ENV=local
DATABASE_URL=sqlite:///./data/gjakova_cases.db
KB_DIR=knowledge
ARTIFACTS_DIR=artifacts
EMBEDDING_MODEL=intfloat/multilingual-e5-small
DUPLICATE_WINDOW_DAYS=30
MERGE_THRESHOLD=0.78
GEO_RADIUS_METERS=100
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8000
